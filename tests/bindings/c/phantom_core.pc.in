# pkg-config template for libphantom_core. The `@PREFIX@` placeholder is
# substituted by package.sh; the default --prefix is /usr/local.
prefix=@PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: phantom_core
Description: Phantom Core — post-quantum-secure L4/L6 transport (C FFI)
URL: https://github.com/SNAcorp/phantom-core
Version: 0.2.0
Cflags: -I${includedir}
Libs: -L${libdir} -lphantom_core
Libs.private: -lpthread -lm -ldl
