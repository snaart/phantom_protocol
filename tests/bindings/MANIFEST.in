# Source-distribution manifest for the phantom_protocol Python wheel.
#
# Per-platform native libraries are included if they happen to be staged
# next to phantom_protocol.py at build time (e.g. via `cp
# target/release/libphantom_protocol.{dylib,so} tests/bindings/`). They are
# NOT redistributable across platforms — each wheel must be built on the
# target OS / arch.
include libphantom_protocol.dylib
include libphantom_protocol.so
include libphantom_protocol.dll
