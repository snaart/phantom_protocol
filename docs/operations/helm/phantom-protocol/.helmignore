# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.gitattributes
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Backup / swap files
*.swp
*.bak
*.tmp
*~
# OS artifacts
Thumbs.db
# Editor artifacts
*.orig
# Test artifacts
*.test
# Helm-specific
*.tgz
