# Phantom Protocol reference server — environment variables.
#
# Most values here also have a CLI form (see `phantom-server --help`); the env
# fallback is what systemd / docker / Kubernetes deployments use. The
# exceptions are OTEL_METRIC_EXPORT_INTERVAL and OTEL_EXPORTER_OTLP_HEADERS,
# which the OpenTelemetry SDK reads straight from the environment — they have
# no CLI flag.
#
# All values are example placeholders — review before deploying.

# TCP bind address for the Phantom transport.
PHANTOM_BIND=0.0.0.0:4242

# Path to the long-lived HybridSigningKey blob. Created on first run if
# missing (0600 on Unix). Persist this across restarts so clients keep
# pinning the same verifying key.
PHANTOM_SIGNING_KEY_FILE=/etc/phantom-server/signing.key

# Emit structured JSON logs. Recommended in containerized environments.
PHANTOM_LOG_JSON=true

# Tracing filter. Default is info,phantom_protocol=debug.
RUST_LOG=info,phantom_protocol=info

# --- Admission control ---
# Maximum concurrent sessions. Once full, the server stops accepting
# (connections queue in the OS backlog) until a session closes — backpressure,
# not a hard drop. Size it below LimitNOFILE (one fd per session, plus headroom)
# and within memory. 0 = unbounded.
#
# Two memory figures, and they are far apart: an ordinary session sits around
# 512 KiB, but the *bound* on what one authenticated peer can make a session
# hold is 108 MiB (receive windows × reorder buffers × streams). It is bounded
# per session and not divided between sessions, so this cap is what bounds the
# process. See docs/operations/deployment.md before raising it.
PHANTOM_MAX_SESSIONS=1024

# Receive-side memory this process may commit to peers, in MiB. 0 (default)
# states no budget and leaves PHANTOM_MAX_SESSIONS alone. Setting it lowers the
# session cap to what the budget can hold (108 MiB per session) and refuses to
# start if it cannot hold one — the way to size a host by memory rather than by
# session count.
PHANTOM_MAX_RECV_MEMORY_MIB=0

# Maximum concurrent sessions from a single source IP (a peer at the cap has
# further connections rejected after the handshake). Stops one source from
# monopolising the global pool. 0 disables the per-IP cap.
PHANTOM_MAX_SESSIONS_PER_IP=64

# --- OpenTelemetry (Phase 8) ---
# Phantom Protocol pushes metrics + traces over OTLP/gRPC. There is no inbound
# /metrics port — point this at your OTel Collector (or a SaaS OTLP gateway).
# See docs/observability/otlp-setup.md for backend-specific recipes.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Service name reported via the OTel Resource.
OTEL_SERVICE_NAME=phantom-server

# Trace sampling ratio (0.0–1.0) — the env fallback for
# --otel-trace-sample-ratio. The server installs it directly on the
# TracerProvider as ParentBased(TraceIdRatioBased(ratio)), so it takes effect
# on its own; OTEL_TRACES_SAMPLER does not need to be set (and is not
# consulted). ParentBased honors an upstream decision, so the ratio gates root
# spans only. The server default is 1.0 (export every trace); the 0.01 below is
# an example 1% production baseline — raise it during incidents. Values outside
# 0.0–1.0 are clamped.
OTEL_TRACES_SAMPLER_ARG=0.01

# Metric export interval, milliseconds. OTel SDK default is 10s.
OTEL_METRIC_EXPORT_INTERVAL=10000

# Optional: auth headers for a SaaS OTLP endpoint (Datadog / Honeycomb / ...).
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>
