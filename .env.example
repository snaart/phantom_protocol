# Phantom Core reference server — environment variables.
#
# Every value here also has a CLI form (see `phantom-server --help`); the env
# fallback is what systemd / docker / Kubernetes deployments use.
#
# All values are example placeholders — review before deploying.

# TCP bind address for the Phantom transport.
PHANTOM_BIND=0.0.0.0:4242

# Path to the long-lived HybridSigningKey blob. Created on first run if
# missing (0600 on Unix). Persist this across restarts so clients keep
# pinning the same verifying key.
PHANTOM_SIGNING_KEY_FILE=/etc/phantom-server/signing.key

# Optional: bind a /metrics HTTP listener (Prometheus text exposition).
# Leave unset to disable. Bind to a private interface in production.
PHANTOM_METRICS_BIND=127.0.0.1:9090

# Emit structured JSON logs. Recommended in containerized environments.
PHANTOM_LOG_JSON=true

# Tracing filter. Default is info,phantom_core=debug.
RUST_LOG=info,phantom_core=info
